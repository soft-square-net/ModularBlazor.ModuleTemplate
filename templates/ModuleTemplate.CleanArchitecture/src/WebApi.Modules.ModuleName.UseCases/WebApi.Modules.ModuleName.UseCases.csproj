<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="soft.square.net.ModularBlazor.Module.Sdk" />

  <!--
    Use cases: one folder per use case (Notes/Create, Notes/Edit, ...), each a Mediator command or query and its
    handler, returning an Ardalis Result. Also the module's permissions, settings and DTOs.
    References Core only. The Module SDK compiles it against WebApi.SharedKernel, WebApi.Contracts and ASP.NET Core,
    all provided by the host. Mediator.Abstractions and Ardalis.Result are private: copied into the module's output
    and loaded in its own load context, so they unload with it.
    The name does not end in .Application, so the layer is set here.
  -->

  <PropertyGroup>
    <ModuleLayer>Application</ModuleLayer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ardalis.Result" Version="$(ArdalisResultVersion)" />
    <PackageReference Include="Mediator.Abstractions" Version="$(MediatorVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebApi.Modules.ModuleName.Core\WebApi.Modules.ModuleName.Core.csproj" />
  </ItemGroup>

</Project>
