{
  "$schema": "http://json.schemastore.org/template",
  "author": "soft-square-net",
  "classifications": [ "ModularBlazor", "Module", "Clean Architecture", "Web", "API" ],
  "identity": "soft.square.net.ModularBlazor.ModuleTemplate.CleanArchitecture",
  "name": "ModularBlazor runtime module (Clean Architecture)",
  "description": "A ModularBlazor runtime module in Ardalis Clean Architecture layers (Core, UseCases, Infrastructure, Web), with a Note example (add, edit, delete, get, list, search), unit and integration tests, and an Aspire playground.",
  "shortName": "platform-module-ca",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "ModuleName",
  "preferNameDirectory": true,
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "**/.vs/**",
            "**/*.user",
            "playground/.data/**",
            "playground/out/**"
          ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    { "path": "ModularBlazor.Module.ModuleName.slnx" }
  ]
}
